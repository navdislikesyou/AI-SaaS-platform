# Copy to .env and adjust. Never commit .env.

# ---- Application ----
APP_NAME="AI SaaS Platform API"
APP_VERSION="0.1.0"
ENVIRONMENT=development  # development | staging | production
DEBUG=false
API_V1_PREFIX=/api/v1

# ---- Server ----
HOST=127.0.0.1
PORT=8000

# ---- CORS ----
# JSON list. Use explicit origins; wildcards are rejected in production.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FORMAT=console  # console | json
LOG_REQUEST_BODY=false  # keep false; request bodies may contain user data

# ---- Agent integrations ----
# Knowledge and Automation are connected behind their adapters. Setting a flag
# true attempts to construct that agent at startup; if construction fails the
# adapter logs the error and reports unavailable, so the API still boots.
# Requires `pip install -r requirements.txt -r requirements-agents.txt`.
KNOWLEDGE_AGENT_ENABLED=false
AUTOMATION_AGENT_ENABLED=false

# Performance is not an /agents/execute agent: its analysis is CPU-bound and
# runs as a background job instead.
#   POST /api/v1/performance/jobs
#   GET  /api/v1/performance/jobs/{job_id}
# This flag only controls its catalog entry, which stays unavailable.
PERFORMANCE_AGENT_ENABLED=false

# ---- Agent execution limits ----
# Per-operation wall-clock budgets. Inference is CPU-bound, so these must
# cover a full generation on slow hardware; an 8B model on CPU takes minutes.
# Exceeding the budget returns 504.
KNOWLEDGE_AGENT_TIMEOUT_SECONDS=300
AUTOMATION_AGENT_TIMEOUT_SECONDS=180
PERFORMANCE_AGENT_TIMEOUT_SECONDS=600

# How many agent operations may run at once, across all agents. Agent work is
# CPU-bound, so this is deliberately low: a higher value buys no extra
# throughput on a small machine and only adds context switching. A timed-out
# agent thread cannot be killed, so it holds its slot until it truly finishes.
AGENT_MAX_CONCURRENCY=4

# ---- Knowledge Agent ----
# Vector store directory. Relative paths resolve from the backend directory.
KNOWLEDGE_CHROMA_PATH=knowledge_agent/data/chroma_db
KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# ---- Knowledge document upload ----
# Where POST /api/v1/knowledge/documents stores uploaded files, and where the
# JSON metadata manifest lives. Both paths resolve from the backend directory.
#
# LOCAL STORAGE IS A DEVELOPMENT MVP. Files live on the machine running the API
# and are not shared between instances, so a multi-worker or multi-host
# deployment will not find a document it did not index. A deployment needs
# persistent shared storage and a real metadata store.
KNOWLEDGE_UPLOAD_DIR=uploads/knowledge
KNOWLEDGE_UPLOAD_MANIFEST_PATH=uploads/knowledge/documents.json

# Largest accepted upload, enforced while streaming. 25 MiB.
KNOWLEDGE_MAX_UPLOAD_BYTES=26214400

# ---- Automation employee directory upload ----
# Where POST /api/v1/automation/directories stores uploaded directories, and
# where the JSON metadata manifest lives. Both paths resolve from the backend
# directory.
#
# LOCAL STORAGE IS A DEVELOPMENT MVP, for the same reasons as the Knowledge
# upload above. Employee directories are not shared between instances and the
# manifest is a single JSON file, so concurrent writes across processes are not
# safe. A deployment needs persistent shared storage and a real metadata store.
AUTOMATION_UPLOAD_DIR=uploads/automation
AUTOMATION_UPLOAD_MANIFEST_PATH=uploads/automation/directories.json

# Largest accepted upload, enforced while streaming. Employee directories are
# small text files, so this is far below the Knowledge document limit. 2 MiB.
AUTOMATION_MAX_UPLOAD_BYTES=2097152

# Largest accepted employee count in one directory. Bounds the work a single
# draft can do and the memory one request may use.
AUTOMATION_MAX_DIRECTORY_EMPLOYEES=5000

# ---- Local LLM (Ollama) ----
# Prerequisite for the Knowledge and Automation agents: install Ollama, run
# `ollama serve`, then `ollama pull llama3.1:8b`. The agents are constructed
# once at startup, so a missing server surfaces as a 503, not a crash.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ---- Reserved for later phases (unused today) ----
# DATABASE_URL=
# SECRET_KEY=