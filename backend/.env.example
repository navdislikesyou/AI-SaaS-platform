# Copy to .env and adjust. Never commit .env.

# ---- Application ----
APP_NAME="AI SaaS Platform API"
APP_VERSION="0.1.0"
ENVIRONMENT=development  # development | staging | production
DEBUG=false
API_V1_PREFIX=/api/v1

# ---- Server ----
HOST=127.0.0.1
PORT=8000

# ---- CORS ----
# JSON list. Use explicit origins; wildcards are rejected in production.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FORMAT=console  # console | json
LOG_REQUEST_BODY=false  # keep false; request bodies may contain user data

# ---- Agent integrations ----
# Knowledge and Automation are connected behind their adapters. Setting a flag
# true attempts to construct that agent at startup; if construction fails the
# adapter logs the error and reports unavailable, so the API still boots.
# Requires `pip install -r requirements.txt -r requirements-agents.txt`.
PERFORMANCE_AGENT_ENABLED=false  # deferred, no implementation wired in
KNOWLEDGE_AGENT_ENABLED=false
AUTOMATION_AGENT_ENABLED=false

# ---- Agent execution limits ----
# Per-operation wall-clock budgets. Inference is CPU-bound, so these must
# cover a full generation on slow hardware; an 8B model on CPU takes minutes.
# Exceeding the budget returns 504.
KNOWLEDGE_AGENT_TIMEOUT_SECONDS=300
AUTOMATION_AGENT_TIMEOUT_SECONDS=180
PERFORMANCE_AGENT_TIMEOUT_SECONDS=600

# How many agent operations may run at once, across all agents. Agent work is
# CPU-bound, so this is deliberately low: a higher value buys no extra
# throughput on a small machine and only adds context switching. A timed-out
# agent thread cannot be killed, so it holds its slot until it truly finishes.
AGENT_MAX_CONCURRENCY=4

# ---- Knowledge Agent ----
# Vector store directory. Relative paths resolve from the backend directory.
KNOWLEDGE_CHROMA_PATH=knowledge_agent/data/chroma_db
KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# ---- Local LLM (Ollama) ----
# Prerequisite for the Knowledge and Automation agents: install Ollama, run
# `ollama serve`, then `ollama pull llama3.1:8b`. The agents are constructed
# once at startup, so a missing server surfaces as a 503, not a crash.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ---- Reserved for later phases (unused today) ----
# DATABASE_URL=
# SECRET_KEY=