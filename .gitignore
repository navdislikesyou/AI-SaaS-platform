# Python
__pycache__/
*.py[cod]
*.pyo

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environment
.venv/
venv/

# VS Code
.vscode/

# Environment variables
.env
.env.*
# Templates are tracked; the real files never are.
!.env.example
!.env.*.example

# Local SQLite databases (the default DATABASE_URL points at ./app.db)
*.db

# Generated test and lint output written into the backend directory.
# The requirements manifests are source files and stay tracked.
backend/*.txt
!backend/requirements.txt
!backend/requirements-agents.txt

# Coverage output
.coverage
.coverage.*
coverage.xml
htmlcov/
frontend/coverage/

# Uploaded files
backend/uploads/
backend/outputs/

# Models
*.pt
*.pth
*.bin
*.gguf
*.safetensors

# Agent vector stores and generated artifacts
*.sqlite3
backend/knowledge_agent/data/chroma_db/
backend/knowledge_agent/data/documents/
backend/performance_agent/data/
backend/performance_agent/results/

# Runtime activity history (regenerated by the app)
backend/activity_history/data/

# Logs
*.log

# OS files
.DS_Store
Thumbs.db